#include <bits/stdc++.h>

using namespace std;
int main()
{
    int n;
    cin >> n;
    vector < int > A(n);
    stack < int > s;
    for (int i = 0; i < n; i++)
    {
        cin >> A[i];
        s.push(A[i]);
    }
    for (int i = 0; i < n; i++) {
        if (A[i] == s.top()) {
            s.pop();
        }
        else
        {
            cout << 0 << endl;
            return 0;
        }
    }
    cout << 1 << endl;
    return 0;
}
